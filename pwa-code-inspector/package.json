{
  "name": "@local/pwa-code-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA Code Inspector: a professional PWA web app developer panel that audits smartphone formatting, PWA readiness, and logic-flow issues.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
